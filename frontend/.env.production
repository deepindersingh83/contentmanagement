# Base URL the frontend uses for API calls in a production build.
#
# Default "/api" means the API must be reachable at the SAME origin, e.g.
#   https://app.gamingdesktop.com.au/api/...
# If your backend lives under a different path (for example alongside the
# frontend at /contentmanagement/api), set it explicitly:
#   VITE_API_URL=/contentmanagement/api
VITE_API_URL=/api
